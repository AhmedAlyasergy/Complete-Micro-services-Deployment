# Copy to .env (cp .env.example .env) and change the values.
# .env is git-ignored, so real secrets never get committed.

DB_USER=postgres
DB_PASSWORD=change-me-db-password

# Shared by all three services
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h

# Shared by products-service and orders-service
INTERNAL_API_KEY=change-me-internal-key

# Admin account created on first startup
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=change-me-admin-password

# Port the gateway listens on, on your machine
GATEWAY_PORT=8080
